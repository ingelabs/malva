#!/bin/bash

# GNU coreutils installs this as gtimeout on some systems, including macOS
if command -v timeout >/dev/null 2>&1; then
  timeout_command=timeout
elif command -v gtimeout >/dev/null 2>&1; then
  timeout_command=gtimeout
else
  timeout_command=
  echo "WARNING: timeout/gtimeout not found; running tests without a timeout" >&2
fi

# Default to 30 seconds, override with TEST_TIMEOUT env var
TEST_TIMEOUT=${TEST_TIMEOUT:-30}

timeout_prefix=()
if [ -n "$timeout_command" ]; then
  timeout_prefix=("$timeout_command" --verbose --kill-after=5s "${TEST_TIMEOUT}s")
fi

run=0
failed=0

function check
{
  name=${1#src/}
  case "$1" in
    *.class)
      name=${name%.class}
      "${timeout_prefix[@]}" $JAVA -cp src "$name"
      ;;
    *.sh)
      "${timeout_prefix[@]}" bash "$1"
      ;;
  esac
  status=$?
  if [ "$status" != "0" ]; then
    echo "$name: FAILED (exit $status)"
    failed=$((failed + 1))
    [ "$SUITE_RUN_ALL" != "1" ] && exit 1
  else
    echo "$name: OK"
  fi
  run=$((run + 1))
}

for t in $(find src \( -name "*Test.class" -o -name "*test.sh" \) | sort -f); do
  check $t
done

echo ""
echo "Tests run: $run, Failed: $failed"
if [ "$failed" != "0" ]; then
  exit 1
fi
